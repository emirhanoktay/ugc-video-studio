# fal.ai API anahtarini asagidaki satira yapistir.
# Format: uuid:hex   ornek: a1b2c3d4-5e6f-7890-abcd-ef1234567890:9876...
# https://fal.ai/dashboard/keys
FAL_KEY=

# fal.ai Admin API anahtari — bakiye gostergesi icin (opsiyonel).
# Billing scope'u olan bir key olustur: https://fal.ai/dashboard/keys
# Yoksa bakiye gostergesi gizlenir, uretim yine calisir.
FAL_ADMIN_KEY=

# Port (varsayilan 3000, degistirmek istersen)
PORT=3000
